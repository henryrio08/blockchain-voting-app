# Copy this file to .env.local and fill in the values.
# For Sepolia, use the HTTPS RPC URL from your Alchemy app.
VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
VITE_CHAIN_ID=11155111

# Deploy Voting.sol first, then paste the deployed contract address.
VITE_CONTRACT_ADDRESS=

# Optional gas sponsorship (Sepolia only). Create an active policy in Alchemy Gas Manager.
# These values are public in the browser; never put a wallet private key here.
VITE_ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY
VITE_ALCHEMY_POLICY_ID=YOUR_GAS_SPONSORSHIP_POLICY_ID
